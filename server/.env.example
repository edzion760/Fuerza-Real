DATABASE_URL="file:./fuerza-real.db"
JWT_SECRET="cambiar-por-un-texto-largo-y-secreto"
PORT=4100
# Dirección pública de la app (la del dominio o del Cloudflare Tunnel).
APP_URL="https://fuerzareal.com"
# Código que se pide para crear una cuenta de entrenador. Solo lo conocen ustedes.
REGISTRO_CODIGO="cambiar-este-codigo"

# Generar una sola vez con: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Gratis: las notificaciones las entrega el navegador del celular.
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_CONTACTO="mailto:fuerzareal@example.com"
